# Appwrite cloud endpoint, e.g. https://syd.cloud.appwrite.io/v1 (match your region)
VITE_APPWRITE_ENDPOINT=
# Appwrite project ID (Console -> Overview -> Settings)
VITE_APPWRITE_PROJECT_ID=
# Database + collection IDs (create these in the Appwrite console)
VITE_APPWRITE_DATABASE_ID=gocrazydeals
VITE_APPWRITE_PRODUCTS_COLLECTION_ID=products
VITE_APPWRITE_ORDERS_COLLECTION_ID=orders
# Storage bucket for product images (bucket needs Read permission for role "any")
VITE_APPWRITE_BUCKET_ID=
# Storage bucket for crypto payment evidence uploads (private, id "evidence")
VITE_APPWRITE_EVIDENCE_BUCKET_ID=evidence
# Comma-separated Appwrite user IDs allowed to access /admin
VITE_ADMIN_USER_IDS=
# Paystack PUBLIC key (pk_test_...) — powers the checkout popup. Never put the secret key in any VITE_ var.
VITE_PAYSTACK_PUBLIC_KEY=